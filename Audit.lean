/-! ### ライブラリ全体の走査

上の一覧は主要な宣言だけを挙げる。次の走査は、モジュール Zeno.* と ZenoSmale.* のすべての宣言
（自動生成の補助宣言を含む）から依存をたどり、現れる公理の和集合を一行で出力する。 -/

open Lean Elab Command in
/-- 宣言 n から依存をたどり、訪れた宣言と見つけた公理を集める。 -/
partial def auditVisit (env : Environment) (n : Name) : StateM (NameSet × NameSet) Unit := do
  let (seen, _) ← get
  if seen.contains n then return
  modify fun (s, a) => (s.insert n, a)
  match env.find? n with
  | none => return
  | some ci =>
    if let .axiomInfo _ := ci then
      modify fun (s, a) => (s, a.insert n)
    for c in ci.getUsedConstantsAsSet.toList do
      auditVisit env c

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let names := env.constants.fold (fun (acc : Array Name) name _ =>
    match env.getModuleIdxFor? name with
    | some idx =>
      let m := env.header.moduleNames[idx.toNat]!
      if m.getRoot == `Zeno || m.getRoot == `ZenoSmale then acc.push name else acc
    | none => acc) #[]
  let ((), (_, ax)) := (names.forM (auditVisit env)).run ({}, {})
  let sorted := (ax.toList.map toString).toArray.qsort (· < ·)
  logInfo m!"all declarations in the modules Zeno.* and ZenoSmale.* depend on axioms: [{", ".intercalate sorted.toList}]"
